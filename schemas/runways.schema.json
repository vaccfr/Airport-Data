{
  "title": "Runway database",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "airac": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "source": {
      "type": "string"
    },
    "airports": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z0-9]{4}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "position": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lon"
            ]
          },
          "runways": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "lengthM": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "ends": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": {
                        "ident": {
                          "type": "string",
                          "pattern": "^(0[1-9]|[12][0-9]|3[0-6])[LCR]?$"
                        },
                        "trueHeading": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMaximum": 360
                        },
                        "magneticHeading": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 360
                        },
                        "threshold": {
                          "type": "object",
                          "properties": {
                            "lat": {
                              "type": "number",
                              "minimum": -90,
                              "maximum": 90
                            },
                            "lon": {
                              "type": "number",
                              "minimum": -180,
                              "maximum": 180
                            }
                          },
                          "required": [
                            "lat",
                            "lon"
                          ]
                        }
                      },
                      "required": [
                        "ident",
                        "trueHeading"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "ident": {
                          "type": "string",
                          "pattern": "^(0[1-9]|[12][0-9]|3[0-6])[LCR]?$"
                        },
                        "trueHeading": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMaximum": 360
                        },
                        "magneticHeading": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 360
                        },
                        "threshold": {
                          "type": "object",
                          "properties": {
                            "lat": {
                              "type": "number",
                              "minimum": -90,
                              "maximum": 90
                            },
                            "lon": {
                              "type": "number",
                              "minimum": -180,
                              "maximum": 180
                            }
                          },
                          "required": [
                            "lat",
                            "lon"
                          ]
                        }
                      },
                      "required": [
                        "ident",
                        "trueHeading"
                      ]
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "id",
                "ends"
              ]
            }
          }
        },
        "required": [
          "position",
          "runways"
        ]
      }
    }
  },
  "required": [
    "airports"
  ]
}
